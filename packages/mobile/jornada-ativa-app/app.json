{
  "expo": {
    "name": "jornada-ativa-app",
    "slug": "jornada-ativa-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "jornadaativaapp",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",

    "splash": {
      "image": "./assets/images/ja-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000",
      "dark": {
        "backgroundColor": "#000000",
        "image": "./assets/images/ja-logo.png",
        "resizeMode": "contain"
      }
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "image": "./assets/images/ja-logo.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
 
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
